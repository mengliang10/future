---
import {ClientRouter,fade} from 'astro:transitions';
import Icon from '../components/Icon.astro';
import {records} from '../lib/catalogue';
import '../styles/site.css';
import '../styles/chirping.css';
const {title='The Future Tomorrow',description='Technology research for business readers and investors.',active='Home'}=Astro.props;
const nav=[['Home','/','home'],['Explore','/explore/','explore'],['Categories','/sectors/','categories'],['Roadmaps','/roadmaps/','roadmap'],['Companies','/companies/','companies'],['Presentations','/presentations/','slides'],['Research','/research/','research'],['About','/read/about/','info']];
const [sectors,decks]=await Promise.all([records('sectors'),records('decks')]);
const recent=decks.filter(d=>d.mode==='evergreen').sort((a,b)=>b.added.localeCompare(a.added)||a.id.localeCompare(b.id)).filter(d=>d.id.endsWith('-01')).slice(0,5);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | The Future Tomorrow</title><meta name="description" content={description}/><meta name="theme-color" content="#f4f5f6"/><link rel="icon" href="/images/future-avatar.svg"/><ClientRouter fallback="none"/><script is:inline data-astro-rerun>try{document.documentElement.dataset.theme=localStorage.getItem('future-theme')||'light';}catch{}</script></head><body class="chirping-site">
<a class="skip" href="#main">Skip to content</a>
<aside class="site-sidebar" aria-label="Site navigation"><a href="/" class="sidebar-brand" aria-label="The Future Tomorrow home"><img src="/images/future-avatar.svg" width="108" height="108" alt=""/><strong>The Future Tomorrow</strong></a><p class="sidebar-tagline">Technology, business &amp; investment.<br/>Explained for the rest of us.</p><nav id="primary-nav" aria-label="Primary navigation">{nav.map(([name,href,icon])=><a href={href} aria-current={active===name?'page':undefined}><Icon name={icon}/><span>{name}</span></a>)}</nav><div class="sidebar-bottom"><button type="button" data-theme-toggle aria-label="Toggle dark mode"><Icon name="moon"/></button><a href="https://github.com/mengliang10/future" target="_blank" rel="noopener noreferrer" aria-label="Original GitHub research">GH</a><a href="/read/contact/" aria-label="Contact">@</a><a href="/research/" aria-label="Evidence and methodology"><Icon name="info"/></a></div></aside>
<button class="sidebar-mask" type="button" aria-label="Close navigation" hidden></button>
<div class="site-workspace"><header class="topbar"><button class="menu-button" aria-controls="primary-nav" aria-expanded="false" type="button" aria-label="Open navigation"><Icon name="menu"/></button><div class="topbar-location"><a href="/">Home</a>{active!=='Home'&&<><span>/</span><span>{active}</span></>}</div><a href="/" class="mobile-brand">The Future Tomorrow</a><form action="/explore/" class="topbar-search"><Icon name="search" size={15}/><label class="sr-only" for="global-search">Search the site</label><input id="global-search" type="search" name="q" placeholder="Search the site"/><kbd>/</kbd></form></header>
<div class="content-grid"><div class="content-column"><main id="main" transition:animate={fade({duration:'120ms'})}><slot/></main><footer class="footer"><span>© 2026 The Future Tomorrow</span><span>Built with Astro · <a href="https://github.com/kannansuresh/chirping-astro" target="_blank" rel="noopener noreferrer">Chirping-inspired design</a></span><small>Imported research and market snapshots · Verify before acting · Not investment advice.</small></footer></div>
<aside class="reading-panel" aria-label="Related navigation"><section><h2>Latest briefings</h2><ul>{recent.map(d=><li><a href={`/presentations/${d.id}/`} data-astro-reload>{d.title}</a></li>)}</ul></section><section><h2>Browse categories</h2><div class="panel-tags">{sectors.filter(s=>['ai','semiconductors','quantum','robotics','energy','biotech','space','marketing'].includes(s.id)).map(s=><a href={`/sectors/${s.id}/`}>{s.title}</a>)}</div></section><section class="panel-links"><h2>Two perspectives</h2><a href="/explore/">For business readers →</a><a href="/companies/">For investors →</a><a href="/research/">How to read the evidence →</a></section></aside></div></div>
<script>import '../scripts/chirping';</script>
</body></html>
