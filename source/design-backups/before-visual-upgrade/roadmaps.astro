---
import Site from '../layouts/Site.astro';import {records} from '../lib/catalogue';const tech=await records('technologies');
const horizons=[{id:'now',label:'Now–2028',min:0,max:2028},{id:'next',label:'2029–2030',min:2029,max:2030},{id:'decade',label:'2031–2040',min:2031,max:2040},{id:'later',label:'2041–2050',min:2041,max:2050},{id:'beyond',label:'Beyond 2050',min:2051,max:9999}];
---
<Site title="Roadmaps" active="Roadmaps"><div class="container page"><div class="page-heading"><h1>Time is a hypothesis.</h1><p>Browse source-estimated milestones. These windows are research assumptions, not forecasts or promises.</p></div><nav class="horizon-nav" aria-label="Roadmap horizons">{horizons.map(h=><a href={'#'+h.id}>{h.label}</a>)}<a href="#undated">Unspecified</a></nav>{horizons.map(h=><section id={h.id} class="horizon"><div><span class="eyebrow">Estimated deployment</span><h2>{h.label}</h2><span>{tech.filter(t=>t.estimateYear!==null&&t.estimateYear>=h.min&&t.estimateYear<=h.max).length} records</span></div><div class="horizon-links">{tech.filter(t=>t.estimateYear!==null&&t.estimateYear>=h.min&&t.estimateYear<=h.max).map(t=><a href={`/tech/${t.id}/`}>{t.title}<span>{t.estimate}</span></a>)}</div></section>)}<section id="undated" class="horizon"><div><h2>Unspecified</h2><p>No numeric estimate in the source record.</p></div><div class="horizon-links">{tech.filter(t=>t.estimateYear===null).map(t=><a href={`/tech/${t.id}/`}>{t.title}</a>)}</div></section></div></Site>
