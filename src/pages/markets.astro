---
import {url, base} from '../lib/base';
import Site from '../layouts/Site.astro';import snapshot from '../../public/data/market-snapshot.json';import {records} from '../lib/catalogue';
const companies=await records('companies');
---
<Site title="Market snapshot" active="Companies"><div class="container page"><div class="page-heading"><h1>Market snapshot.</h1><p>Source timestamp: <time datetime={snapshot.updated}>{snapshot.updated}</time>. Imported values, not live quotes.</p></div><p class="data-note">Currency is not specified in this source dataset. Values and source-generated signals have not been revalidated. Use the company research to investigate further.</p><div class="table-wrap"><table><thead><tr><th>Company</th><th>Ticker</th><th>Sector</th><th>Price</th><th>Change %</th><th>Source signal</th></tr></thead><tbody>{snapshot.stocks.map(s=><tr><td>{companies.some(c=>c.id===s.ticker.toLowerCase())?<a href={url(`/companies/${s.ticker.toLowerCase()}/`)}>{s.name}</a>:s.name}</td><td>{s.ticker}</td><td>{s.sector}</td><td>{s.price??'—'}</td><td>{s.change_pct??'—'}</td><td>{s.signal||'—'}</td></tr>)}</tbody></table></div><a href={url('/data/market-snapshot.json')} download>Download source JSON ↓</a></div></Site>
