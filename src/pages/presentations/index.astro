---
import {url, base} from '../../lib/base';
import Site from '../../layouts/Site.astro';
import Browse from '../../components/Browse.astro';
import Icon from '../../components/Icon.astro';
import {records} from '../../lib/catalogue';
import {visualFor, officialSectorsOrder} from '../../lib/visuals';

const [items, sectors, technologies] = await Promise.all([
  records('decks'),
  records('sectors'),
  records('technologies')
]);

// Sort official sector briefing decks first
const sortedSectors = [...sectors].sort((a,b) => {
  const ia = officialSectorsOrder.indexOf(a.id);
  const ib = officialSectorsOrder.indexOf(b.id);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

const officialDecks = sortedSectors.map(s => {
  return items.find(d => d.id === `${s.id}-01`) || items.find(d => d.sector === s.id);
}).filter(Boolean);

const otherDecks = items.filter(d => !officialDecks.some(od => od.id === d.id));
---
<Site title="Presentations Studio" active="Presentations">
  <div class="container page presentation-hub-page">
    <header class="presentation-studio-hero">
      <div class="studio-badge">
        <Icon name="slides" size={16}/>
        <span>STANDALONE PRESENTATION STUDIO · 16:9 REVEAL.JS BRIEFINGS</span>
      </div>
      <h1>Official Sector & Technology Presentations</h1>
      <p class="studio-intro">
        Executive slide decks mapping tomorrow’s breakthrough technologies directly onto the 11 official global sectors.
        Present live in full-screen Reveal.js mode, switch to Reading Document mode, or query each slide with the built-in AI assistant.
      </p>

      <div class="studio-meta-grid">
        <div class="studio-stat">
          <strong>11</strong>
          <span>Official Sectors</span>
        </div>
        <div class="studio-stat">
          <strong>{items.length}</strong>
          <span>Total Presentation Decks</span>
        </div>
        <div class="studio-stat">
          <strong>Reveal.js + AI</strong>
          <span>Slide Engine & Query API</span>
        </div>
        <div class="studio-stat">
          <strong>100%</strong>
          <span>PDF Export Ready</span>
        </div>
      </div>
    </header>

    <!-- Official 11 Sectors Presentation Showcase -->
    <section class="official-decks-section">
      <div class="section-title-wrap">
        <div>
          <span class="eyebrow-accent">PRIMARY DECK SUITE</span>
          <h2>The 11 Official Sector Briefings</h2>
        </div>
        <span class="sector-weight-note">Weighted by official market taxonomy</span>
      </div>

      <div class="official-decks-grid">
        {sortedSectors.map(s => {
          const v = visualFor(s.id);
          const deck = items.find(d => d.id === `${s.id}-01`) || items.find(d => d.sector === s.id);
          const techCount = technologies.filter(t => t.sector === s.id).length;
          return (
            <article class="official-deck-card" style={`--sector-accent: ${v.color}; --sector-pale: ${v.pale};`}>
              <div class="deck-card-header">
                <span class="sector-tag">
                  <span class="sector-icon" aria-hidden="true">{v.icon}</span>
                  <strong>{s.title}</strong>
                </span>
                <span class="sector-pill-weight">Weight: {s.weight || v.weight || '—'}</span>
                <span class="sector-pill-change">Day: {s.change || v.change || '—'}</span>
              </div>

              <h3>
                <a href={url(`/presentations/${deck ? deck.id : s.id + '-01'}/`)} data-astro-reload>
                  {s.title} — Sector Briefing
                </a>
              </h3>

              <p class="deck-question">{s.businessQuestion}</p>

              <div class="deck-card-footer">
                <span class="slide-count">
                  {deck ? `${deck.technologies.length + 3} slides` : '15 slides'} · {techCount} Techs
                </span>
                <div class="deck-action-buttons">
                  <a class="deck-btn-read" href={url(`/presentations/${deck ? deck.id : s.id + '-01'}/?view=read`)} data-astro-reload>
                    Read
                  </a>
                  <a class="deck-btn-present" href={url(`/presentations/${deck ? deck.id : s.id + '-01'}/`)} data-astro-reload>
                    Present ↗
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Full Deck Browser / Archive -->
    <section class="all-decks-section">
      <div class="section-title-wrap">
        <div>
          <span class="eyebrow-accent">FULL PRESENTATION LIBRARY</span>
          <h2>All Available Presentations & Archived Snapshots</h2>
        </div>
      </div>
      <Browse items={items} sectors={sectors} kind="deck" title="presentations"/>
    </section>
  </div>
</Site>

<style>
.presentation-hub-page {
  padding-bottom: 60px;
}
.presentation-studio-hero {
  background: linear-gradient(135deg, #0f2b23 0%, #15382e 50%, #1a4237 100%);
  color: #f7faf7;
  padding: 40px 42px;
  border-radius: 12px;
  margin-bottom: 40px;
  box-shadow: 0 10px 30px rgba(15, 43, 35, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.studio-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(253, 211, 68, 0.15);
  color: #fdd344;
  border: 1px solid rgba(253, 211, 68, 0.4);
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 18px;
}
.presentation-studio-hero h1 {
  font-size: clamp(30px, 3.8vw, 44px);
  color: #ffffff;
  margin: 0 0 14px;
  line-height: 1.15;
  letter-spacing: -0.03em;
}
.studio-intro {
  font-size: 16px;
  line-height: 1.55;
  color: #d1ded7;
  max-width: 820px;
  margin: 0 0 28px;
}
.studio-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  padding-top: 22px;
}
.studio-stat {
  display: flex;
  flex-direction: column;
}
.studio-stat strong {
  font-size: 24px;
  font-weight: 700;
  color: #fdd344;
}
.studio-stat span {
  font-size: 12px;
  color: #b7cbbf;
  margin-top: 2px;
}

.official-decks-section {
  margin-bottom: 50px;
}
.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 12px;
}
.eyebrow-accent {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.09em;
  color: var(--muted);
  display: block;
  margin-bottom: 4px;
}
.section-title-wrap h2 {
  font-size: 26px;
  margin: 0;
  color: var(--ink);
}
.sector-weight-note {
  font-size: 13px;
  color: var(--muted);
}

.official-decks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}
.official-deck-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 4px solid var(--sector-accent);
  border-radius: 8px;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.official-deck-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}
.deck-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}
.sector-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--ink);
  font-weight: 600;
}
.sector-icon {
  color: var(--sector-accent);
  font-size: 15px;
}
.sector-pill-weight, .sector-pill-change {
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 600;
}
.sector-pill-weight {
  background: var(--sector-pale);
  color: var(--sector-accent);
}
.sector-pill-change {
  background: #f0fdf4;
  color: #166534;
}
.official-deck-card h3 {
  font-size: 19px;
  margin: 0 0 10px;
  line-height: 1.3;
}
.official-deck-card h3 a {
  color: var(--ink);
  text-decoration: none;
}
.official-deck-card h3 a:hover {
  color: var(--sector-accent);
  text-decoration: underline;
}
.deck-question {
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
  margin: 0 0 18px;
  flex: 1;
}
.deck-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  font-size: 12px;
}
.slide-count {
  color: var(--muted);
}
.deck-action-buttons {
  display: flex;
  gap: 8px;
}
.deck-btn-read, .deck-btn-present {
  display: inline-block;
  padding: 5px 11px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
}
.deck-btn-read {
  background: var(--surface-alt);
  color: var(--ink);
  border: 1px solid var(--line);
}
.deck-btn-present {
  background: var(--ink);
  color: #fff;
}
.deck-btn-present:hover {
  background: var(--sector-accent);
}

@media (max-width: 760px) {
  .presentation-studio-hero {
    padding: 24px 20px;
  }
  .section-title-wrap {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .official-decks-grid {
    grid-template-columns: 1fr;
  }
}
</style>
