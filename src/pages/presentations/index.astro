---
import {url, base} from '../../lib/base';
import Site from '../../layouts/Site.astro';
import Browse from '../../components/Browse.astro';
import Icon from '../../components/Icon.astro';
import {records} from '../../lib/catalogue';
import {visualFor, officialStockSectors, officialSectorsOrder} from '../../lib/visuals';

const [items, technologies] = await Promise.all([
  records('decks'),
  records('technologies')
]);

// Official Stock Sectors Definitions for the Presentations Studio
const officialSectors = officialSectorsOrder.map(id => {
  const meta = officialStockSectors[id];
  const deck = items.find(d => d.id === `${id}-01`);
  return {
    id,
    title: meta.short === 'Info Tech' ? 'Information Technology' : meta.short === 'Comm Services' ? 'Communication Services' : meta.short === 'Cons. Discretionary' ? 'Consumer Discretionary' : meta.short === 'Cons. Staples' ? 'Consumer Staples' : meta.short,
    short: meta.short,
    weight: meta.weight,
    change: meta.change,
    color: meta.color,
    pale: meta.pale,
    icon: meta.icon,
    deck: deck || items.find(d => d.id.includes(id)) || items[0]
  };
});

const slideCount = items.reduce((n,d)=> n + ((d.slides&&d.slides.length) ? d.slides.length + 1 : d.technologies.length + 4), 0);
const officialDeckIds = new Set(officialSectors.map(s => s.deck.id));
const otherDecks = items.filter(d => !officialDeckIds.has(d.id));
---
<Site title="Presentations Studio" active="Presentations">
  <div class="container page presentation-hub-page">
    <header class="presentation-studio-hero">
      <div class="studio-badge">
        <Icon name="slides" size={16}/>
        <span>STANDALONE PRESENTATION STUDIO · 16:9 REVEAL.JS BRIEFINGS</span>
      </div>
      <h1>Official Stock Sectors & Technology Presentations</h1>
      <p class="studio-intro">
        Executive slide decks mapping breakthrough technologies directly onto the 11 official global stock sectors (Energy, IT, Financials, Health Care, Industrials, etc.).
        Present live in full-screen Reveal.js mode, switch to Reading Document mode, or query each slide with the built-in AI assistant.
      </p>

      <div class="studio-meta-grid">
        <div class="studio-stat">
          <strong>11</strong>
          <span>Official Stock Sectors</span>
        </div>
        <div class="studio-stat">
          <strong>{items.length}</strong>
          <span>Briefing Decks</span>
        </div>
        <div class="studio-stat">
          <strong>{slideCount.toLocaleString('en-US')}</strong>
          <span>Rendered Slides</span>
        </div>
        <div class="studio-stat">
          <strong>16:9</strong>
          <span>Reveal.js Format</span>
        </div>
      </div>
    </header>

    <!-- SECTION 1: 11 OFFICIAL GLOBAL STOCK SECTORS -->
    <section class="official-decks-section">
      <div class="section-title-wrap">
        <div>
          <span class="studio-kicker">Market Taxonomy</span>
          <h2>The 11 Official Stock Sectors</h2>
        </div>
        <span class="sector-weight-note">Weighted by official market taxonomy (Energy, IT, Financials, etc.)</span>
      </div>

      <div class="official-decks-grid">
        {officialSectors.map(s => {
          return (
            <article class="official-deck-card" style={`--sector-accent: ${s.color}; --sector-pale: ${s.pale};`}>
              <div class="deck-card-top">
                <span class="sector-symbol" aria-hidden="true">{s.icon}</span>
                <div class="deck-weight-pills">
                  <span class="pill-weight">{s.weight} Weight</span>
                  <span class="pill-change">{s.change}</span>
                </div>
              </div>

              <h3>
                <a href={url(`/presentations/${s.deck.id}/`)} data-astro-reload>
                  {s.title}
                </a>
              </h3>

              <p class="deck-card-summary">
                How future technology changes the revenue, cost and capital allocation of {s.title}: impact map, supply-chain products, adoption timeline and the signposts that would prove the thesis wrong.
              </p>

              <div class="deck-card-footer">
                <div class="deck-slides-info">
                  <Icon name="slides" size={14}/>
                  <span>{s.deck.slides && s.deck.slides.length ? s.deck.slides.length + 1 : s.deck.technologies.length + 4} Slides</span>
                </div>

                <div class="deck-actions">
                  <a class="action-btn action-read" href={url(`/presentations/${s.deck.id}/?view=read`)} data-astro-reload title="Reading document view">
                    Read
                  </a>
                  <a class="action-btn action-present" href={url(`/presentations/${s.deck.id}/`)} data-astro-reload title="Launch 16:9 Reveal.js Presentation">
                    Present ↗
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- SECTION 2: SPECIALIZED FUTURE TECH PRESENTATIONS -->
    <section class="all-decks-section">
      <div class="section-title-wrap">
        <div>
          <span class="studio-kicker">Deep Dives</span>
          <h2>Future Technology Briefings Library</h2>
        </div>
        <span class="decks-count-badge">{otherDecks.length} specialized briefings</span>
      </div>

      <Browse items={otherDecks} kind="deck" title="briefings" compact={true}/>
    </section>
  </div>
</Site>

<style>
.presentation-hub-page {
  padding-bottom: 60px;
}
.presentation-studio-hero {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 32px 30px;
  margin-bottom: 36px;
}
.studio-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--surface-alt);
  color: var(--muted);
  border: 1px solid var(--line);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 16px;
}
.presentation-studio-hero h1 {
  font-size: 32px;
  line-height: 1.2;
  margin: 0 0 12px;
  color: var(--ink);
}
.studio-intro {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text);
  max-width: 820px;
  margin: 0 0 24px;
}
.studio-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 16px;
  border-top: 1px solid var(--line);
  padding-top: 20px;
}
.studio-stat {
  display: flex;
  flex-direction: column;
}
.studio-stat strong {
  font-size: 20px;
  font-weight: 800;
  color: var(--ink);
}
.studio-stat span {
  font-size: 12px;
  color: var(--muted);
  margin-top: 2px;
}

.official-decks-section {
  margin-bottom: 48px;
}
.section-title-wrap {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 18px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.studio-kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
  display: block;
  margin-bottom: 4px;
}
.section-title-wrap h2 {
  font-size: 22px;
  margin: 0;
  color: var(--ink);
}
.sector-weight-note {
  font-size: 12px;
  color: var(--muted);
}
.decks-count-badge {
  font-size: 12px;
  background: var(--surface-alt);
  padding: 3px 8px;
  border-radius: 4px;
  color: var(--muted);
  border: 1px solid var(--line);
}

.official-decks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 18px;
}
.official-deck-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 4px solid var(--sector-accent);
  border-radius: 6px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.official-deck-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
}
.deck-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.sector-symbol {
  font-size: 20px;
  color: var(--sector-accent);
}
.deck-weight-pills {
  display: flex;
  gap: 6px;
  font-size: 11px;
}
.pill-weight {
  background: var(--sector-pale);
  color: var(--sector-accent);
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 700;
}
.pill-change {
  background: #f0fdf4;
  color: #166534;
  padding: 2px 7px;
  border-radius: 4px;
  font-weight: 600;
}
.official-deck-card h3 {
  font-size: 17px;
  line-height: 1.35;
  margin: 0 0 8px;
}
.official-deck-card h3 a {
  color: var(--ink);
  text-decoration: none;
}
.official-deck-card h3 a:hover {
  color: var(--sector-accent);
  text-decoration: underline;
}
.deck-card-summary {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text);
  margin: 0 0 16px;
  flex: 1;
}
.deck-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--line);
  padding-top: 12px;
  margin-top: auto;
}
.deck-slides-info {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
}
.deck-actions {
  display: flex;
  gap: 6px;
}
.action-btn {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 4px;
  text-decoration: none;
  border: 1px solid var(--line);
  transition: all 0.15s ease;
}
.action-read {
  background: var(--surface);
  color: var(--ink);
}
.action-read:hover {
  background: var(--surface-alt);
}
.action-present {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}
.action-present:hover {
  background: var(--sector-accent);
  border-color: var(--sector-accent);
}

@media (max-width: 680px) {
  .official-decks-grid {
    grid-template-columns: 1fr;
  }
}
</style>
