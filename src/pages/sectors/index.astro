---
import {url, base} from '../../lib/base';
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import {records} from '../../lib/catalogue';
import {visualFor, futureTechOrder} from '../../lib/visuals';

const [sectors, tech, companies, decks] = await Promise.all([
  records('sectors'),
  records('technologies'),
  records('companies'),
  records('decks')
]);

// Sort sectors by Future Tech Order
const sortedSectors = [...sectors].sort((a,b) => {
  const ia = futureTechOrder.indexOf(a.id);
  const ib = futureTechOrder.indexOf(b.id);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
---
<Site title="Future Technology Sectors" active="Future Tech">
  <div class="container page sectors-overview-page">
    <header class="page-heading">
      <div class="heading-kicker">
        <Icon name="categories" size={16}/>
        <span>FUTURE TECH TAXONOMY · RESEARCH & HARDWARE ROADMAPS</span>
      </div>
      <h1>Future Technology Sectors.</h1>
      <p>
        Frontier technologies organized by engineering domains: Semiconductors, Memory, Quantum Computing, Drugs & Biotech, LLM Models, Robotics, Energy, Space, and more.
      </p>
    </header>

    <div class="official-sectors-table-wrap">
      <div class="official-sectors-grid">
        {sortedSectors.map(s => {
          const v = visualFor(s.id);
          const sectorTech = tech.filter(t => t.sector === s.id);
          const sectorComps = companies.filter(c => c.sector === s.id);
          const deck = decks.find(d => d.sector === s.id) || decks.find(d => d.id === `${s.id}-01`);

          return (
            <article class="sector-card" style={`--sector-accent: ${v.color}; --sector-pale: ${v.pale};`}>
              <div class="sector-top-bar">
                <span class="sector-emblem-badge" aria-hidden="true">{v.icon}</span>
                <div class="sector-weights-badge">
                  <span class="tech-count-badge"><strong>{sectorTech.length}</strong> Technologies</span>
                  <span class="comp-count-badge"><strong>{sectorComps.length}</strong> Companies</span>
                </div>
              </div>

              <h2>
                <a href={url(`/sectors/${s.id}/`)}>{s.title}</a>
              </h2>

              <p class="sector-question">{s.businessQuestion}</p>

              <div class="sector-card-actions">
                <a class="action-explore" href={url(`/sectors/${s.id}/`)}>
                  Explore Tech Roadmap →
                </a>
                {deck && (
                  <a class="action-presentation" href={url(`/presentations/${deck.id}/`)} data-astro-reload>
                    <Icon name="slides" size={13}/>
                    <span>Briefing</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</Site>

<style>
.sectors-overview-page {
  padding-bottom: 60px;
}
.heading-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--surface-alt);
  color: var(--muted);
  border: 1px solid var(--line);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.official-sectors-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
  margin-top: 24px;
}
.sector-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 5px solid var(--sector-accent);
  border-radius: 8px;
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.sector-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}
.sector-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}
.sector-emblem-badge {
  font-size: 22px;
  color: var(--sector-accent);
}
.sector-weights-badge {
  display: flex;
  gap: 8px;
  font-size: 11px;
}
.tech-count-badge, .comp-count-badge {
  padding: 3px 8px;
  border-radius: 4px;
  background: var(--surface-alt);
  color: var(--text);
  border: 1px solid var(--line);
}
.tech-count-badge strong, .comp-count-badge strong {
  color: var(--ink);
}
.sector-card h2 {
  font-size: 20px;
  margin: 0 0 10px;
}
.sector-card h2 a {
  color: var(--ink);
  text-decoration: none;
}
.sector-card h2 a:hover {
  color: var(--sector-accent);
  text-decoration: underline;
}
.sector-question {
  font-size: 13px;
  line-height: 1.55;
  color: var(--text);
  margin: 0 0 20px;
  flex: 1;
}
.sector-card-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--line);
  padding-top: 14px;
  margin-top: auto;
}
.action-explore {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
}
.action-explore:hover {
  text-decoration: underline;
  color: var(--sector-accent);
}
.action-presentation {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--surface-alt);
  color: var(--ink);
  border: 1px solid var(--line);
  padding: 5px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease;
}
.action-presentation:hover {
  background: var(--ink);
  color: #fff;
}

@media (max-width: 760px) {
  .official-sectors-grid {
    grid-template-columns: 1fr;
  }
}
</style>
