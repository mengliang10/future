---
import {sectorLenses} from '../../lib/research-lenses';
import {url, base} from '../../lib/base';
import {sourceLinks} from '../../lib/source-links';
import Site from '../../layouts/Site.astro';
import Browse from '../../components/Browse.astro';
import SectorPortrait from '../../components/SectorPortrait.astro';
import Icon from '../../components/Icon.astro';
import {records} from '../../lib/catalogue';
import {visualFor} from '../../lib/visuals';

export async function getStaticPaths(){
  return (await records('sectors')).map(sector=>({params:{id:sector.id},props:{sector}}));
}

const {sector}=Astro.props;
const [tech, sectors, articles, decks, companies]=await Promise.all([
  records('technologies'),
  records('sectors'),
  records('articles'),
  records('decks'),
  records('companies')
]);

const v = visualFor(sector.id);
const sectorDecks = decks.filter(d=>d.sector===sector.id);
const primaryDeck = sectorDecks.find(d=>d.id===`${sector.id}-01`) || sectorDecks[0];
const sectorTech = tech.filter(t=>t.sector===sector.id);
const sectorCompanies = companies.filter(c=>c.sector===sector.id || (c.sectors||[]).includes(sector.id));
---
<Site title={sector.title} active="Future Tech">
  <div class="container page sector-detail-page">
    <nav class="sector-breadcrumb">
      <a href={url('/sectors/')}>← All Future Tech Sectors</a>
      <span>/</span>
      <span>{sector.title}</span>
    </nav>

    <header class="sector-header-banner" style={`--sector-accent: ${v.color}; --sector-pale: ${v.pale};`}>
      <div class="banner-top">
        <span class="sector-emblem">{v.icon}</span>
        <div class="banner-pills">
          <span class="pill-records"><strong>{sectorTech.length}</strong> Technologies</span>
          <span class="pill-records"><strong>{sectorCompanies.length}</strong> Companies</span>
        </div>
      </div>

      <h1>{sector.title}</h1>
      <p class="sector-core-question">{sector.businessQuestion}</p>

      <div class="sector-banner-footer">
        <div class="sector-lens-block">
          <span class="lens-label">Investor Lens</span>
          <p>{sector.investorQuestion}</p>
        </div>

        {primaryDeck && (
          <div class="sector-banner-actions">
            <a class="deck-cta-btn" href={url(`/presentations/${primaryDeck.id}/`)} data-astro-reload>
              <Icon name="slides" size={15}/>
              <span>Open Briefing Slides ({(primaryDeck.slides && primaryDeck.slides.length ? primaryDeck.slides.length + 1 : primaryDeck.technologies.length + 4)} slides) →</span>
            </a>
          </div>
        )}
      </div>
    </header>

    <section class="sector-portrait-section" aria-label={`${sector.title} at a glance`}>
      <div class="section-heading-row">
        <h2>{sector.title} at a glance</h2>
        <span class="records-counter">Derived from imported records</span>
      </div>
      <SectorPortrait technologies={sectorTech} companies={sectorCompanies} accent={v.color}/>
    </section>

    {sector.overview && (
      <section class="sector-overview" style={`--sector-accent: ${v.color};`} aria-label={`Editorial overview of ${sector.title}`}>
        <span class="lens-label">Editorial overview</span>
        <p>{sector.overview}</p>{sectorLenses[sector.id] && <p>{sectorLenses[sector.id]} <a href="https://www.damnang.com/archive?sort=new">Research inspiration</a> (questions for further verification).</p>}
      </section>
    )}

    <section class="sector-content-section">
      <div class="section-heading-row">
        <h2>Technology Roadmaps & Records in {sector.title}</h2>
        <span class="records-counter">{sectorTech.length} records</span>
      </div>
      <Browse items={sectorTech} sectors={sectors} initialSector={sector.id} title={sector.title}/>
    </section>

    {sectorCompanies.length > 0 && (
      <section class="sector-content-section companies-section">
        <div class="section-heading-row">
          <h2>Key Company Exposure ({sector.title})</h2>
          <span class="records-counter">{sectorCompanies.length} companies</span>
        </div>
        <Browse items={sectorCompanies} sectors={sectors} initialSector={sector.id} kind="company" title={`${sector.title} Companies`}/>
      </section>
    )}
  </div>
</Site>

<style>
.sector-detail-page {
  padding-bottom: 60px;
}
.sector-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 20px;
}
.sector-breadcrumb a {
  color: var(--ink);
  text-decoration: none;
  font-weight: 500;
}
.sector-breadcrumb a:hover {
  text-decoration: underline;
}
.sector-header-banner {
  background: var(--surface);
  border: 1px solid var(--line);
  border-top: 5px solid var(--sector-accent);
  border-radius: 8px;
  padding: 32px 30px;
  margin-bottom: 40px;
}
.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.sector-emblem {
  font-size: 28px;
  color: var(--sector-accent);
}
.banner-pills {
  display: flex;
  gap: 8px;
  font-size: 12px;
}
.pill-records {
  background: var(--sector-pale);
  color: var(--sector-accent);
  padding: 4px 10px;
  border-radius: 4px;
}
.pill-records strong {
  font-weight: 700;
}
.sector-header-banner h1 {
  font-size: 32px;
  margin: 0 0 12px;
  color: var(--ink);
}
.sector-core-question {
  font-size: 16px;
  line-height: 1.6;
  color: var(--text);
  max-width: 800px;
  margin: 0 0 24px;
}
.sector-banner-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding-top: 20px;
}
.sector-lens-block {
  max-width: 580px;
}
.lens-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 4px;
}
.sector-lens-block p {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text);
  margin: 0;
}
.deck-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--ink);
  color: #fff;
  padding: 9px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease;
}
.deck-cta-btn:hover {
  background: var(--sector-accent);
}
.sector-overview {
  margin: 0 0 38px;
  padding: 22px 26px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-left: 4px solid var(--sector-accent);
  border-radius: 6px;
  max-width: 960px;
}
.sector-overview p {
  margin: 8px 0 0;
  font-size: 16px;
  line-height: 1.72;
  color: var(--text);
}
.sector-content-section {
  margin-top: 40px;
}
.section-heading-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line);
}
.section-heading-row h2 {
  font-size: 20px;
  margin: 0;
  color: var(--ink);
}
.records-counter {
  font-size: 12px;
  color: var(--muted);
}
.companies-section {
  margin-top: 50px;
}
.sector-portrait-section {
  margin: 0 0 34px;
  padding: 20px 24px 12px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 8px;
}
</style>
