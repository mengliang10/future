---
import {url, base} from '../../lib/base';
import {sourceLinks} from '../../lib/source-links';
import Site from '../../layouts/Site.astro';
import Browse from '../../components/Browse.astro';
import Icon from '../../components/Icon.astro';
import {records} from '../../lib/catalogue';
import {visualFor} from '../../lib/visuals';

export async function getStaticPaths(){
  return (await records('sectors')).map(sector=>({params:{id:sector.id},props:{sector}}));
}

const {sector}=Astro.props;
const [tech, sectors, articles, decks, companies]=await Promise.all([
  records('technologies'),
  records('sectors'),
  records('articles'),
  records('decks'),
  records('companies')
]);

const original=articles.find(a=>a.sourcePath===`sectors/${sector.id}.md`);
const v = visualFor(sector.id);
const sectorDecks = decks.filter(d=>d.sector===sector.id);
const primaryDeck = sectorDecks.find(d=>d.id===`${sector.id}-01`) || sectorDecks[0];
const sectorTech = tech.filter(t=>t.sector===sector.id);
const sectorCompanies = companies.filter(c=>c.sector===sector.id);
---
<Site title={sector.title} active="Official Sectors">
  <div class="container page sector-detail-page">
    <nav class="sector-breadcrumb">
      <a href={url('/sectors/')}>← All Official Sectors</a>
      <span>/</span>
      <span>{sector.title}</span>
    </nav>

    <header class="sector-header-banner" style={`--sector-accent: ${v.color}; --sector-pale: ${v.pale};`}>
      <div class="banner-top">
        <span class="sector-emblem">{v.icon}</span>
        <div class="banner-pills">
          <span class="pill-weight">Weight: <strong>{sector.weight || v.weight || '—'}</strong></span>
          <span class="pill-change">Day Change: <strong>{sector.change || v.change || '—'}</strong></span>
        </div>
      </div>

      <h1>{sector.title}</h1>
      <p class="sector-lead-question">{sector.businessQuestion}</p>

      <div class="sector-lenses-grid">
        <div class="lens-box business">
          <span class="lens-title">Business Application Lens</span>
          <p>{sector.businessQuestion}</p>
        </div>
        <div class="lens-box investor">
          <span class="lens-title">Investor & Value Capture Lens</span>
          <p>{sector.investorQuestion}</p>
        </div>
      </div>

      <div class="sector-actions-bar">
        {primaryDeck && (
          <a class="btn-primary-presentation" href={url(`/presentations/${primaryDeck.id}/`)} data-astro-reload>
            <Icon name="slides" size={15}/>
            <span>Launch Reveal.js Sector Briefing ↗</span>
          </a>
        )}
        <a class="btn-company-research" href={url(`/companies/?sector=${sector.id}`)}>
          View {sectorCompanies.length} Tracked Companies →
        </a>
      </div>
    </header>

    <section class="sector-technologies-section">
      <div class="section-header-row">
        <div>
          <span class="eyebrow">APPLICATION TO SECTOR</span>
          <h2>Breakthrough Technologies in {sector.title}</h2>
        </div>
        <span class="tech-count-badge">{sectorTech.length} technologies mapped</span>
      </div>

      <Browse items={sectorTech} sectors={sectors} title={sector.title}/>
    </section>

    {original && (
      <details class="original-notes">
        <summary>Original sector narrative & research archive</summary>
        <div class="prose" set:html={await sourceLinks(original.bodyHtml)}/>
        <a href={url(`/source/${original.sourcePath}`)} download>Original Markdown ↓</a>
      </details>
    )}
  </div>
</Site>

<style>
.sector-detail-page {
  padding-bottom: 60px;
}
.sector-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 20px;
}
.sector-breadcrumb a {
  color: var(--ink);
  text-decoration: none;
  font-weight: 500;
}
.sector-breadcrumb a:hover {
  text-decoration: underline;
}

.sector-header-banner {
  background: var(--surface);
  border: 1px solid var(--line);
  border-top: 5px solid var(--sector-accent);
  border-radius: 8px;
  padding: 32px 36px;
  margin-bottom: 36px;
}
.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.sector-emblem {
  font-size: 28px;
  color: var(--sector-accent);
}
.banner-pills {
  display: flex;
  gap: 10px;
  font-size: 12px;
}
.pill-weight, .pill-change {
  padding: 4px 10px;
  border-radius: 4px;
}
.pill-weight {
  background: var(--sector-pale);
  color: var(--sector-accent);
  font-weight: 600;
}
.pill-change {
  background: #f0fdf4;
  color: #166534;
  font-weight: 600;
}
.sector-header-banner h1 {
  font-size: clamp(32px, 4vw, 48px);
  margin: 0 0 12px;
  color: var(--ink);
}
.sector-lead-question {
  font-size: 17px;
  color: var(--text);
  line-height: 1.5;
  margin: 0 0 24px;
  max-width: 860px;
}
.sector-lenses-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 28px;
}
.lens-box {
  background: var(--surface-alt);
  border: 1px solid var(--line);
  padding: 18px 20px;
  border-radius: 6px;
}
.lens-title {
  display: block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 8px;
}
.lens-box p {
  font-size: 14px;
  line-height: 1.5;
  margin: 0;
  color: var(--ink);
}
.sector-actions-bar {
  display: flex;
  gap: 14px;
  align-items: center;
  flex-wrap: wrap;
}
.btn-primary-presentation {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--ink);
  color: #fff;
  padding: 10px 18px;
  border-radius: 5px;
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease;
}
.btn-primary-presentation:hover {
  background: var(--sector-accent);
}
.btn-company-research {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
}
.btn-company-research:hover {
  text-decoration: underline;
  color: var(--sector-accent);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 22px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 12px;
}
.section-header-row h2 {
  font-size: 24px;
  margin: 0;
}
.tech-count-badge {
  font-size: 13px;
  color: var(--muted);
}

@media (max-width: 760px) {
  .sector-header-banner {
    padding: 22px 20px;
  }
  .sector-lenses-grid {
    grid-template-columns: 1fr;
  }
}
</style>
