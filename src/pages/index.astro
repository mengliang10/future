---
import {url, base} from '../lib/base';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import HorizonStrip from '../components/HorizonStrip.astro';
import {records} from '../lib/catalogue';
import {visualFor, futureTechOrder} from '../lib/visuals';

const [technologies, companies, sectors, decks] = await Promise.all([
  records('technologies'),
  records('companies'),
  records('sectors'),
  records('decks')
]);

const pick = (words) => technologies.find(t => words.some(w => (t.title + ' ' + t.id).toLowerCase().includes(w)));
const featured = [
  pick(['2nm process node', 'hbm3']),
  pick(['quantum error correction', 'fault tolerant']),
  pick(['humanoid robot', 'robotics foundation']),
  pick(['crispr', 'mrna', 'cancer elimination'])
].filter(Boolean);

const sortedSectors = [...sectors].sort((a,b) => {
  const ia = futureTechOrder.indexOf(a.id);
  const ib = futureTechOrder.indexOf(b.id);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
const selectedSectors = sortedSectors.slice(0, 8);
const briefings = decks.filter(d => ['semiconductors-01', 'quantum-01', 'energy-01', 'robotics-01'].includes(d.id));
---
<Site title="The Future Tomorrow" active="Home"><div class="discovery-feed">
<section class="discovery-cover"><div class="cover-copy"><span class="visual-kicker">The future, in focus</span><h1>See the signal.<br/><em>Understand the story.</em></h1><p>Technology research sorted by engineering frontiers and breakthroughs. A clearer view of what comes next.</p><a class="discovery-button" href={url('/explore/')}>Explore future tech <Icon name="arrow" size={16}/></a></div><div class="signal-orbit" aria-hidden="true"><div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><div class="orbit-core"><span>THE NEXT</span><strong>What if?</strong></div><span class="orbit-satellite satellite-ai">Chips</span><span class="orbit-satellite satellite-quantum">Quantum</span><span class="orbit-satellite satellite-energy">Energy</span><span class="orbit-point point-one"></span><span class="orbit-point point-two"></span></div><div class="discovery-dots" aria-hidden="true"></div></section>
<div class="discovery-counts"><a href={url('/explore/')}><b>{technologies.length}</b><span>Future Tech records</span><Icon name="arrow" size={13}/></a><a href={url('/companies/')}><b>{companies.length}</b><span>Company profiles</span><Icon name="arrow" size={13}/></a><a href={url('/presentations/')}><b>11</b><span>Official Stock Briefings</span><Icon name="arrow" size={13}/></a></div>
<section class="curiosity-section"><div class="visual-section-top"><div><span class="visual-kicker">Future Tech Domains</span><h2>Explore breakthroughs by engineering category.</h2></div><a href={url('/sectors/')}>All {sectors.length} categories →</a></div><div class="curiosity-grid">{selectedSectors.map(s=>{const v=visualFor(s.id);return <a href={url(`/sectors/${s.id}/`)} class="curiosity-card" style={`--sector:${v.color};--sector-pale:${v.pale}`}><span class="sector-emblem" aria-hidden="true">{v.icon}</span><div><h3>{v.short}</h3><span>{technologies.filter(t=>t.sector===s.id).length} records</span></div><span class="curiosity-arrow" aria-hidden="true">↗</span></a>;})}</div></section>
<HorizonStrip technologies={technologies}/>
<section class="discovery-stories"><div class="visual-section-top"><div><span class="visual-kicker">Look closer</span><h2>Big ideas. Real questions.</h2></div><a href={url('/explore/')}>Keep exploring →</a></div><div class="story-grid">{featured.map(record=>{const v=visualFor(record.sector);return <article class="story-card" style={`--sector:${v.color};--sector-pale:${v.pale}`}><div class="story-category"><span aria-hidden="true">{v.icon}</span><a href={url(`/sectors/${record.sector}/`)}>{v.short}</a></div><h3><a href={url(`/tech/${record.id}/`)}>{record.title}</a></h3><p>{record.summary}</p><div class="story-footer"><span>{record.stage.replaceAll('_',' ')}</span><a href={url(`/tech/${record.id}/`)} aria-label={`Read ${record.title}`}>Read →</a></div></article>;})}</div></section>
<section class="visual-briefings"><div class="visual-section-top"><div><span class="visual-kicker">Executive briefings</span><h2>Slide decks for key domains.</h2></div><a href={url('/presentations/')}>Official Sectors Studio →</a></div><div class="briefing-duo">{briefings.map(deck=>{const v=visualFor(deck.sector);return <a href={url(`/presentations/${deck.id}/`)} data-astro-reload style={`--sector:${v.color};--sector-pale:${v.pale}`}><span class="briefing-pattern" aria-hidden="true">{v.icon}</span><span>THE FUTURE TOMORROW / BRIEFING</span><h3>{deck.title}</h3><span>{deck.technologies.length+3} slides <b>Open ↗</b></span></a>;})}</div></section>
<div class="editorial-note"><Icon name="info" size={18}/><p>Good questions beat false certainty. Read the source, separate a possibility from a prediction, and <a href={url('/research/')}>understand how the evidence is labelled.</a></p></div>
</div></Site>
