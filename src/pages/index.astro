---
import {url, base} from '../lib/base';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import HorizonStrip from '../components/HorizonStrip.astro';
import {records} from '../lib/catalogue';
import {visualFor, officialSectorsOrder} from '../lib/visuals';

const [technologies,companies,sectors,decks]=await Promise.all(['technologies','companies','sectors','decks'].map(records));
const pick=(words)=>technologies.find(t=>words.some(w=>(t.title+' '+t.id).toLowerCase().includes(w)));
const featured=[pick(['ai software engineering agent']),pick(['hbm3']),pick(['humanoid robot']),pick(['silicon photonics'])].filter(Boolean);
const sortedSectors = [...sectors].sort((a,b) => {
  const ia = officialSectorsOrder.indexOf(a.id);
  const ib = officialSectorsOrder.indexOf(b.id);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
const selectedSectors = sortedSectors.slice(0, 6);
const briefings=decks.filter(d=>['information-technology-01','energy-01','financials-01'].includes(d.id));
---
<Site title="The Future Tomorrow" active="Home"><div class="discovery-feed">
<section class="discovery-cover"><div class="cover-copy"><span class="visual-kicker">The future, in focus</span><h1>See the signal.<br/><em>Understand the story.</em></h1><p>Technology explained through business questions and investment perspectives. A clearer view of what could come next.</p><a class="discovery-button" href={url('/explore/')}>Explore the research <Icon name="arrow" size={16}/></a></div><div class="signal-orbit" aria-hidden="true"><div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><div class="orbit-core"><span>THE NEXT</span><strong>What if?</strong></div><span class="orbit-satellite satellite-ai">AI</span><span class="orbit-satellite satellite-quantum">Quantum</span><span class="orbit-satellite satellite-energy">Energy</span><span class="orbit-point point-one"></span><span class="orbit-point point-two"></span></div><div class="discovery-dots" aria-hidden="true"></div></section>
<div class="discovery-counts"><a href={url('/explore/')}><b>{technologies.length}</b><span>Technology records</span><Icon name="arrow" size={13}/></a><a href={url('/companies/')}><b>{companies.length}</b><span>Company profiles</span><Icon name="arrow" size={13}/></a><a href={url('/presentations/')}><b>{decks.filter(d=>d.mode==='evergreen').length}</b><span>HTML briefings</span><Icon name="arrow" size={13}/></a></div>
<section class="curiosity-section"><div class="visual-section-top"><div><span class="visual-kicker">Official Market Sectors</span><h2>Application to the official sectors by future tech.</h2></div><a href={url('/sectors/')}>All 11 sectors →</a></div><div class="curiosity-grid">{selectedSectors.map(s=>{const v=visualFor(s.id);return <a href={url(`/sectors/${s.id}/`)} class="curiosity-card" style={`--sector:${v.color};--sector-pale:${v.pale}`}><span class="sector-emblem" aria-hidden="true">{v.icon}</span><div><h3>{v.short} <small style="font-size:11px;font-weight:600;opacity:0.8;">({s.weight || v.weight})</small></h3><span>{technologies.filter(t=>t.sector===s.id).length} records</span></div><span class="curiosity-arrow" aria-hidden="true">↗</span></a>;})}</div></section>
<HorizonStrip technologies={technologies}/>
<section class="discovery-stories"><div class="visual-section-top"><div><span class="visual-kicker">Look closer</span><h2>Big ideas. Real questions.</h2></div><a href={url('/explore/')}>Keep exploring →</a></div><div class="story-grid">{featured.map(record=>{const v=visualFor(record.sector);return <article class="story-card" style={`--sector:${v.color};--sector-pale:${v.pale}`}><div class="story-category"><span aria-hidden="true">{v.icon}</span><a href={url(`/sectors/${record.sector}/`)}>{v.short}</a></div><h3><a href={url(`/tech/${record.id}/`)}>{record.title}</a></h3><p>{record.summary}</p><div class="story-footer"><span>{record.stage.replaceAll('_',' ')}</span><a href={url(`/tech/${record.id}/`)} aria-label={`Read ${record.title}`}>Read →</a></div></article>;})}</div></section>
<section class="visual-briefings"><div class="visual-section-top"><div><span class="visual-kicker">Take the idea into the room</span><h2>A briefing worth opening.</h2></div><a href={url('/presentations/')}>All presentations →</a></div><div class="briefing-duo">{briefings.map(deck=>{const v=visualFor(deck.sector);return <a href={url(`/presentations/${deck.id}/`)} data-astro-reload style={`--sector:${v.color};--sector-pale:${v.pale}`}><span class="briefing-pattern" aria-hidden="true">{v.icon}</span><span>THE FUTURE TOMORROW / BRIEFING</span><h3>{deck.title}</h3><span>{deck.technologies.length+3} slides <b>Open ↗</b></span></a>;})}</div></section>
<div class="editorial-note"><Icon name="info" size={18}/><p>Good questions beat false certainty. Read the source, separate a possibility from a prediction, and <a href={url('/research/')}>understand how the evidence is labelled.</a></p></div>
</div></Site>
