---
import {url} from '../lib/base';
const {slide, sector, number, total, techs = [], accent = '#183d33'} = Astro.props;
const d = (slide.diagram || {}) as any;

const clamp = (text = '', max = 30) => (text.length > max ? text.slice(0, max - 1) + '…' : text);
const pad = (n: number) => String(n).padStart(2, '0');

const impact = d.quadrants || [];
const chain = d.stages || [];
const milestones = d.milestones || [];
const layers = d.layers || [];
const bars = d.bars || [];

const years = milestones.map((m: any) => Number(m.year)).filter((n: number) => !Number.isNaN(n));
const yearMin = d.start || (years.length ? Math.min(...years) : 2026);
const yearMax = d.end || (years.length ? Math.max(...years) : 2035);
const tx = (year: number) => 92 + ((year - yearMin) / Math.max(1, yearMax - yearMin)) * 1130;
const lanes = [145, 250, 355];
const timelinePlaced = [...milestones]
  .sort((a: any, b: any) => Number(a.lane || 0) - Number(b.lane || 0) || Number(a.year) - Number(b.year))
  .map((m: any, i: number, all: any[]) => {
    const lane = Number(m.lane || 0);
    const prior = all.slice(0, i).filter((p: any) => Number(p.lane || 0) === lane);
    const crowded = prior.filter((p: any) => Math.abs(tx(Number(p.year)) - tx(Number(m.year))) < 210).length;
    const offset = [0, -44, 44][crowded % 3];
    return {...m, px: tx(Number(m.year)), py: lanes[lane] + offset};
  });

const chainGap = 16;
const chainW = (1320 - chainGap * Math.max(1, chain.length - 1)) / Math.max(1, chain.length);
const barMax = 720;
---
<section class:list={['slide', 'slide-brief', `slide-brief-${slide.kind}`]} data-slide-id={`brief:${number}`} style={`--slide-accent:${accent}`}>
  <div class="slide-top"><span>The Future Tomorrow</span><span>{sector?.title || 'Sector briefing'}</span></div>

  <div class="brief-content">
    {slide.eyebrow && <span class="slide-eyebrow">{slide.eyebrow}</span>}
    <h2 class="brief-title">{slide.title}</h2>

    {slide.kind === 'diagram' && d.kind === 'impact' && (
      <svg class="diagram" viewBox="0 0 1320 520" role="img" aria-label="Impact map: where technology changes the sector's revenue and cost lines over time">
        <text x="92" y="26" class="dg-cap">Near term · to 2028</text>
        <text x="710" y="26" class="dg-cap">Later · 2029 and beyond</text>
        <text x="26" y="70" class="dg-cap">Revenue</text>
        <text x="26" y="330" class="dg-cap">Cost</text>
        {impact.map((q: any, i: number) => {
          const x = i % 2 === 0 ? 92 : 710;
          const y = i < 2 ? 46 : 300;
          return (
            <g>
              <rect x={x} y={y} width="580" height="228" rx="10" fill={i === 1 || i === 2 ? '#e8eee3' : '#eef0e6'} stroke="#c9d2c2"/>
              <text x={x + 24} y={y + 38} class="dg-kicker">{clamp(q.label, 34)}</text>
              {q.items.map((item: string, j: number) => (
                <g>
                  <circle cx={x + 30} cy={y + 74 + j * 42} r="4" fill={accent}/>
                  <text x={x + 46} y={y + 80 + j * 42} class="dg-item">{clamp(item, 52)}</text>
                </g>
              ))}
            </g>
          );
        })}
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'chain' && (
      <svg class="diagram" viewBox="0 0 1320 470" role="img" aria-label="Supply chain diagram of the future products this sector will make, move, finance or operate">
        <defs>
          <marker id="chain-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#7d937f"/>
          </marker>
        </defs>
        <text x="92" y="24" class="dg-cap">{d.caption || 'Upstream inputs → finished products → customer interface'}</text>
        {chain.map((stage: any, i: number) => {
          const x = 92 + i * (chainW + chainGap);
          return (
            <g>
              <rect x={x} y="52" width={chainW} height="330" rx="10" fill="#eef0e6" stroke="#c9d2c2"/>
              <text x={x + 18} y="82" class="dg-kicker">{clamp(stage.label, 24).toUpperCase()}</text>
              <line x1={x + 18} y1="96" x2={x + chainW - 18} y2="96" stroke="#c9d2c2"/>
              {stage.products.map((p: string, j: number) => (
                <g>
                  <rect x={x + 16} y={112 + j * 52} width={chainW - 32} height="38" rx="6" fill="#f7f6ee" stroke="#d6ddcd"/>
                  <text x={x + 30} y={137 + j * 52} class="dg-chip">{clamp(p, 24)}</text>
                </g>
              ))}
              {i < chain.length - 1 && (
                <line x1={x + chainW + 2} y1="217" x2={x + chainW + chainGap - 2} y2="217" stroke="#7d937f" stroke-width="1.5" marker-end="url(#chain-arrow)"/>
              )}
            </g>
          );
        })}
        <text x="92" y="420" class="dg-note">{d.note || 'Each box is a product family that must exist for the downstream stage to work. Companies are linked on the sector page.'}</text>
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'timeline' && (
      <svg class="diagram" viewBox="0 0 1320 470" role="img" aria-label={`Adoption timeline from ${yearMin} to ${yearMax}`}>
        <line x1="92" y1="410" x2="1240" y2="410" stroke="#b9c5b1"/>
        {Array.from({length: yearMax - yearMin + 1}).map((_, i) => {
          const year = yearMin + i;
          return (
            <g>
              <line x1={tx(year)} y1="404" x2={tx(year)} y2="416" stroke="#b9c5b1"/>
              <text x={tx(year)} y="442" class="dg-axis" text-anchor="middle">{year}</text>
            </g>
          );
        })}
        {timelinePlaced.map((m: any) => {
          const x = m.px;
          const y = m.py;
          const anchor = x > 980 ? 'end' : 'start';
          const dx = anchor === 'end' ? -14 : 14;
          return (
            <g>
              <line x1={x} y1={y + 10} x2={x} y2="404" stroke="#cfd7c6" stroke-dasharray="3 5"/>
              <circle cx={x} cy={y} r="7" fill={accent}/>
              <circle cx={x} cy={y} r="13" fill="none" stroke={accent} stroke-opacity=".35"/>
              <text x={x + dx} y={y - 16} text-anchor={anchor} class="dg-milestone">{clamp(m.label, 30)}</text>
              <text x={x + dx} y={y + 5} text-anchor={anchor} class="dg-note">{clamp(m.detail, 34)}</text>
            </g>
          );
        })}
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'stack' && (
      <svg class="diagram" viewBox="0 0 1320 470" role="img" aria-label="Technology stack the sector depends on, from physical infrastructure to customer products">
        {layers.map((layer: any, i: number) => {
          const y = 34 + i * 104;
          return (
            <g>
              <rect x="92" y={y} width="1136" height="88" rx="9" fill="#eef0e6" stroke="#c9d2c2"/>
              <text x="114" y={y + 36} class="dg-kicker">{clamp(layer.label, 22).toUpperCase()}</text>
              <text x="114" y={y + 60} class="dg-note">{clamp(layer.note || '', 34)}</text>
              <line x1="360" y1={y + 14} x2="360" y2={y + 74} stroke="#c9d2c2"/>
              {layer.items.map((item: string, j: number) => (
                <g>
                  <rect x={380 + j * 208} y={y + 24} width="192" height="40" rx="20" fill="#f7f6ee" stroke="#d6ddcd"/>
                  <text x={380 + j * 208 + 96} y={y + 49} text-anchor="middle" class="dg-chip">{clamp(item, 22)}</text>
                </g>
              ))}
            </g>
          );
        })}
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'bars' && (
      <svg class="diagram" viewBox="0 0 1320 440" role="img" aria-label="Relative exposure of the sector's cost and revenue pools">
        <text x="92" y="26" class="dg-cap">{d.caption || 'Directional share of sector economics exposed to the technology shift'}</text>
        {bars.map((bar: any, i: number) => {
          const y = 64 + i * 62;
          const w = Math.max(12, (Number(bar.pct) / 100) * barMax);
          return (
            <g>
              <text x="92" y={y + 26} class="dg-item">{clamp(bar.label, 34)}</text>
              <rect x="460" y={y + 6} width={barMax} height="26" rx="13" fill="#e6eadf"/>
              <rect x="460" y={y + 6} width={w} height="26" rx="13" fill={accent} fill-opacity={i === 0 ? '.95' : '.72'}/>
              <text x={470 + barMax} y={y + 26} class="dg-chip">{bar.pct}%</text>
            </g>
          );
        })}
        <text x="92" y="418" class="dg-note">{d.note || 'Directional synthesis for discussion, not a measured statistic.'}</text>
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'actors' && (
      <svg class="diagram" viewBox="0 0 1320 430" role="img" aria-label={`Ecosystem map: ${(d.groups || []).map((g: any) => g.label).join(', ')}`}>
        <defs>
          <marker id="actors-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#7d937f"/>
          </marker>
        </defs>
        <text x="92" y="26" class="dg-cap">{d.caption || 'Upstream suppliers \u2192 builders \u2192 operators \u2192 customers'}</text>
        {(d.groups || []).map((group: any, i: number) => {
          const cols = Math.max(1, (d.groups || []).length);
          const colW = (1226 - 16 * (cols - 1)) / cols;
          const x = 92 + i * (colW + 16);
          const showArrow = i !== cols - 1;
          return (
            <g>
              <rect x={x} y="52" width={colW} height="318" rx="10" fill="#eef0e6" stroke="#c9d2c2"/>
              <text x={x + 18} y="82" class="dg-kicker">{clamp(group.label, 24).toUpperCase()}</text>
              <line x1={x + 18} y1="94" x2={x + colW - 18} y2="94" stroke="#c9d2c2"/>
              <text x={x + 18} y="118" class="dg-note">{clamp(group.role || '', 38)}</text>
              {(group.names || []).slice(0, 6).map((name: string, j: number) => (
                <g>
                  <rect x={x + 16} y={136 + j * 36} width={colW - 32} height="30" rx="15" fill="#f7f6ee" stroke="#d6ddcd"/>
                  <circle cx={x + 32} cy={151 + j * 36} r="3" fill={accent}/>
                  <text x={x + 44} y={155 + j * 36} class="dg-chip">{clamp(name, 26)}</text>
                </g>
              ))}
              {showArrow && <path d={`M ${x + colW + 1} 228 L ${x + colW + 15} 228`} fill="none" stroke="#7d937f" stroke-width="1.5" marker-end="url(#actors-arrow)"/>}
            </g>
          );
        })}
        <text x="92" y="400" class="dg-note">{d.note || 'Named companies are examples of where capability sits, not endorsements or complete lists.'}</text>
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'risk' && (
      <svg class="diagram" viewBox="0 0 1320 540" role="img" aria-label="Risk map plotting evidence strength against profit-and-loss impact, with a numbered legend">
        <text x="92" y="24" class="dg-cap">{d.caption || 'Where the thesis could break: weak evidence plus high impact is where new information matters most'}</text>
        <rect x="150" y="60" width="1000" height="298" rx="8" fill="#f2f3ec" stroke="#d6ddcd"/>
        <line x1="150" y1="209" x2="1150" y2="209" stroke="#b9c5b1"/>
        <line x1="650" y1="60" x2="650" y2="358" stroke="#b9c5b1"/>
        <text x="150" y="52" class="dg-kicker">High impact, weak proof</text>
        <text x="1150" y="52" text-anchor="end" class="dg-kicker">High impact, strong proof</text>
        <text x="150" y="382" class="dg-kicker">Low impact, weak proof</text>
        <text x="1150" y="382" text-anchor="end" class="dg-kicker">Low impact, strong proof</text>
        <text x="650" y="406" text-anchor="middle" class="dg-axis">Evidence strength →</text>
        <text x="112" y="209" text-anchor="middle" transform="rotate(-90 112 209)" class="dg-axis">P&amp;L impact →</text>
        {(d.items || []).map((item: any, i: number) => {
          const px = 150 + (Number(item.evidence ?? item.certainty ?? 50) / 100) * 1000;
          const py = 358 - (Number(item.impact ?? 50) / 100) * 298;
          return (
            <g>
              <circle cx={px} cy={py} r="14" fill={accent}/>
              <circle cx={px} cy={py} r="21" fill="none" stroke={accent} stroke-opacity=".25"/>
              <text x={px} y={py + 4.5} text-anchor="middle" class="dg-risk-num">{i + 1}</text>
            </g>
          );
        })}
        {(d.items || []).slice(0, 6).map((item: any, i: number) => {
          const col = i > 2 ? 1 : 0;
          const row = i % 3;
          const x = 150 + col * 520;
          const y = 436 + row * 32;
          return (
            <g>
              <circle cx={x + 8} cy={y - 5} r="8" fill={accent}/>
              <text x={x + 8} y={y - 1} text-anchor="middle" class="dg-risk-num">{i + 1}</text>
              <text x={x + 26} y={y} class="dg-item">{clamp(item.label, 48)}</text>
              <text x={x + 26} y={y + 17} class="dg-note">{clamp(item.note || '', 52)}</text>
            </g>
          );
        })}
      </svg>
    )}

    {slide.kind === 'diagram' && d.kind === 'funnel' && (
      <svg class="diagram" viewBox="0 0 1320 470" role="img" aria-label="Value pool by stage, narrowing from gross spend to captured profit">
        <text x="92" y="26" class="dg-cap">{d.caption || 'Gross spend narrows into addressable value, then into the profit a layer can defend'}</text>
        {(d.stages || []).map((stage: any, i: number) => {
          const stages = (d.stages || []).length;
          const rowH = Math.min(74, 360 / Math.max(1, stages));
          const y = 56 + i * (rowH + 10);
          const pct = Number(stage.pct ?? 100);
          const w = 420 + (pct / 100) * 460;
          const next = Number((d.stages || [])[i + 1]?.pct ?? pct);
          const wNext = 420 + (next / 100) * 460;
          const x = 300;
          return (
            <g>
              <polygon points={`${x},${y} ${x + w},${y} ${x + wNext},${y + rowH} ${x + (w - wNext) / 2},${y + rowH}`} fill="#eef0e6" stroke="#c9d2c2"/>
              <text x={x + 20} y={y + rowH / 2 + 5} class="dg-item">{clamp(stage.label, 30)}</text>
              <text x={x + w + 16} y={y + rowH / 2 + 5} class="dg-chip">{pct}%</text>
              {stage.note && <text x={x + w + 70} y={y + rowH / 2 + 5} class="dg-note">{clamp(stage.note, 46)}</text>}
            </g>
          );
        })}
        <text x="92" y="446" class="dg-note">{d.note || 'Percentages are a directional synthesis for discussion, not measured market shares.'}</text>
      </svg>
    )}

    {slide.kind === 'table' && slide.table && (
      <table class="brief-table">
        <thead><tr>{slide.table.head.map((h: string) => <th>{h}</th>)}</tr></thead>
        <tbody>{slide.table.rows.map((row: string[]) => <tr>{row.map((cell: string) => <td set:html={cell}/>)}</tr>)}</tbody>
      </table>
    )}

    {slide.kind === 'columns' && (
      <div class="brief-columns">
        {slide.columns.map((col: any) => (
          <div class="brief-column">
            <span class="brief-column-index">{String(slide.columns.indexOf(col) + 1).padStart(2, '0')}</span>
            <h3>{col.title}</h3>
            {col.body && <p>{col.body}</p>}
            <ul>{col.items.map((item: string) => <li set:html={item}/>)}</ul>
          </div>
        ))}
      </div>
    )}

    {slide.kind === 'points' && (
      <div class="brief-points">
        {slide.body && <p class="brief-lede">{slide.body}</p>}
        <ul>{slide.bullets.map((item: string, i: number) => (
          <li><span class="brief-num">{pad(i + 1)}</span><span set:html={item}/></li>
        ))}</ul>
      </div>
    )}

    {slide.kind === 'statement' && slide.body && <p class="brief-statement">{slide.body}</p>}

    {slide.kind === 'research' && (
      <div class="brief-research">
        <p class="brief-lede">{slide.body}</p>
        <div class="brief-research-grid">
          {techs.slice(0, 8).map((t: any) => (
            <a class="brief-research-card" href={url(`/tech/${t.id}/`)}>
              <span>{t.confidenceLabel || 'Source record'}{t.estimateYear ? ` · ${t.estimateYear}` : ''}</span>
              <strong>{t.title}</strong>
            </a>
          ))}
        </div>
        <p class="brief-source-note">{slide.footnote || 'Each claim in this deck is tied to a source record. Open a record to read the evidence, confidence label and linked companies before presenting the commercial implication.'}</p>
      </div>
    )}

    {slide.kind === 'diagram' && (slide.body || slide.bullets.length > 0) && (
      <div class="brief-diagram-notes">
        {slide.body && <p>{slide.body}</p>}
        {slide.bullets.length > 0 && <ul>{slide.bullets.map((b: string) => <li set:html={b}/>)}</ul>}
      </div>
    )}
  </div>

  <div class="slide-bottom"><span>Scenario synthesis · not a forecast</span><span>{pad(number)} / {pad(total)}</span></div>
  <aside class="notes">{slide.title}. {slide.body} {slide.footnote}</aside>
</section>

<style>
  .slide-brief .brief-content{padding-top:26px}
  .slide-brief .brief-title{font-size:40px;max-width:1240px}
  .slide-brief .slide-eyebrow{margin-bottom:14px;color:#54715d}
  .slide-brief .diagram{width:100%;height:auto;margin-top:8px;overflow:visible}
  .slide-brief .dg-cap{font-size:14px;letter-spacing:.12em;text-transform:uppercase;fill:#5d6e64}
  .slide-brief .dg-kicker{font-size:13px;letter-spacing:.1em;text-transform:uppercase;fill:#5d6e64;font-weight:600}
  .slide-brief .dg-item{font-size:19px;fill:#183d33}
  .slide-brief .dg-chip{font-size:15px;fill:#183d33}
  .slide-brief .dg-note{font-size:14px;fill:#6b7d70}
  .slide-brief .dg-axis{font-size:14px;fill:#6b7d70}
  .slide-brief .dg-milestone{font-size:16px;font-weight:600;fill:#183d33}
  .slide-brief .dg-risk-num{font-size:11px;font-weight:700;fill:#fff}
  .slide-brief .brief-statement{font-size:27px;line-height:1.5;max-width:1180px;margin:24px 0 0;color:#27473a}
  .slide-brief .brief-lede{font-size:21px;line-height:1.5;max-width:1160px;margin:8px 0 18px;color:#3f5a4b}
  .slide-brief .brief-points ul,.slide-brief .brief-diagram-notes ul{list-style:none;margin:0;padding:0;max-width:1200px}
  .slide-brief .brief-points li{display:flex;gap:16px;font-size:21px;line-height:1.4;margin-bottom:12px}
  .slide-brief .brief-num{font-size:13px;letter-spacing:.08em;color:#7b8f7f;padding-top:7px;min-width:24px}
  .slide-brief .brief-diagram-notes{margin-top:10px;display:grid;grid-template-columns:1.1fr 1fr;gap:30px}
  .slide-brief .brief-diagram-notes p{font-size:18px;line-height:1.45;margin:0;color:#3f5a4b}
  .slide-brief .brief-diagram-notes li{font-size:16px;line-height:1.4;margin-bottom:6px;color:#27473a}
  .slide-brief .brief-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:18px}
  .slide-brief .brief-column{background:#eef0e6;border:1px solid #c9d2c2;border-radius:10px;padding:20px 22px}
  .slide-brief .brief-column-index{font-size:12px;letter-spacing:.12em;color:#7b8f7f}
  .slide-brief .brief-column h3{font-family:Outfit,Arial,sans-serif;font-size:23px;font-weight:500;margin:6px 0 10px;line-height:1.2}
  .slide-brief .brief-column p{font-size:15px;line-height:1.4;color:#3f5a4b;margin:0 0 10px}
  .slide-brief .brief-column ul{padding-left:18px;margin:0}
  .slide-brief .brief-column li{font-size:15px;line-height:1.35;margin-bottom:6px}
  .slide-brief .brief-table{width:100%;border-collapse:collapse;margin-top:16px;font-size:17px}
  .slide-brief .brief-table th{text-align:left;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#5d6e64;border-bottom:1px solid #b9c5b1;padding:8px 12px}
  .slide-brief .brief-table td{border-bottom:1px solid #dde3d6;padding:10px 12px;vertical-align:top;line-height:1.35}
  .slide-brief .brief-research-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:10px 0 16px}
  .slide-brief .brief-research-card{display:flex;flex-direction:column;gap:6px;background:#eef0e6;border:1px solid #c9d2c2;border-radius:8px;padding:12px 14px;text-decoration:none!important;color:#183d33}
  .slide-brief .brief-research-card span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#6b7d70}
  .slide-brief .brief-research-card strong{font-size:15px;line-height:1.25;font-weight:500}
  .slide-brief .brief-source-note{font-size:13px;line-height:1.45;color:#6b7d70;max-width:1100px}
  .reading .slide-brief .brief-title{font-size:34px}
  .reading .slide-brief .brief-statement{font-size:21px}
  .reading .slide-brief .brief-points li{font-size:16px}
  @media(max-width:760px){
    .slide-brief .brief-columns{grid-template-columns:1fr}
    .slide-brief .brief-diagram-notes{grid-template-columns:1fr}
    .slide-brief .brief-research-grid{grid-template-columns:1fr 1fr}
  }
  @media print{.slide-brief .diagram{max-height:108mm}}
</style>
