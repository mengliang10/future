---
import {url, base} from '../lib/base';
import {visualFor} from '../lib/visuals';
import {displayTitle} from '../lib/catalogue';
const {items,kind='technology',sectors=[],initialSector='',initialStage='',title='Explore',compact=false}=Astro.props;
const stages=[...new Set(items.map(x=>x.stage).filter(Boolean))].sort();
const fieldLabel=v=>v.replaceAll('_',' ');
---
<section class="browser" data-browser data-initial-sector={initialSector} data-initial-stage={initialStage} data-kind={kind}>
<div class="browse-tools" hidden><label class="search-field"><span class="sr-only">Search {title}</span><input type="search" data-search placeholder={`Search ${title.toLowerCase()}…`} /></label><label><span class="sr-only">Sector</span><select data-sector><option value="">All sectors</option>{sectors.map(s=><option value={s.id}>{s.title}</option>)}</select></label>{stages.length>0&&<label><span class="sr-only">Stage</span><select data-stage><option value="">Any stage</option>{stages.map(s=><option value={s}>{fieldLabel(s)}</option>)}</select></label>}{kind==='company'&&<label><span class="sr-only">Company type</span><select data-type><option value="">All companies</option><option value="listed">Listed</option><option value="private">Private</option></select></label>}<button data-reset type="button">Reset</button></div>
<div class="browse-status"><span data-count>{items.length} records</span><span>Imported research · Verify before acting</span></div>
<div class:list={['browse-list',{'deck-grid':kind==='deck'}]}>{items.map(item=><article class="browse-item" style={`--sector:${visualFor(item.sector).color}`} data-item data-sector={item.sector} data-sectors={[item.sector,...(item.sectors||[])].join(' ')} data-stage={item.stage||''} data-type={item.private?'private':'listed'} data-searchtext={[item.title,item.summary,item.symbol,item.sector,...(item.sectors||[]),item.stage].filter(Boolean).join(' ').toLowerCase()}>
{kind==='deck'?<><a class="deck-cover" href={url(`/presentations/${item.id}/`)} data-astro-reload><span>The Future Tomorrow / Briefing</span><strong>{displayTitle(item.title)}</strong><span>{(item.slides&&item.slides.length?item.slides.length+1:item.technologies.length+4)} slides <b>↗</b></span></a><h2><a href={url(`/presentations/${item.id}/`)} data-astro-reload>{item.title}</a></h2><div class="deck-meta"><time>{item.added}</time><a href={url(`/presentations/${item.id}/?view=read`)} data-astro-reload>Read</a><a href={url(`/presentations/${item.id}/`)} data-astro-reload>Present ↗</a></div></>:<><div class="browse-name"><a href={url(kind==='company'?`/companies/${item.id}/`:`/tech/${item.id}/`)}>{displayTitle(item.title)}</a>{item.summary&&<p>{item.summary}</p>}</div><span class="browse-sector">{sectors.find(s=>s.id===item.sector)?.title||item.sector}</span><span class="browse-stage">{kind==='company'?item.private?'Private':item.symbol:fieldLabel(item.stage||'')}</span><a class="row-arrow" href={url(kind==='company'?`/companies/${item.id}/`:`/tech/${item.id}/`)} aria-label={`Read ${item.title}`}>↗</a></>}
</article>)}</div>
<p class="empty-state" data-empty hidden>No matching records. Try another search or reset the filters.</p><nav class="pagination" aria-label="Result pages" hidden><button type="button" data-previous>← Previous</button><span data-page></span><button type="button" data-next>Next →</button></nav>
</section>
<script>import '../scripts/browse';</script>
