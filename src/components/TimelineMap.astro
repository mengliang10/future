---
import {url, base} from '../lib/base';
import {horizons,horizonFor,visualFor} from '../lib/visuals';
const {technologies,sectors}=Astro.props;
const max=Math.max(...sectors.flatMap(s=>horizons.map(h=>technologies.filter(t=>t.sector===s.id&&horizonFor(t.estimateYear)===h.id).length)));
---
<section class="timeline-explorer" data-timeline>
<div class="timeline-controls" hidden><label><span class="sr-only">Filter timeline by sector</span><select data-timeline-sector><option value="">All sectors</option>{sectors.map(s=><option value={s.id}>{s.title}</option>)}</select></label><label><span class="sr-only">Filter timeline by horizon</span><select data-timeline-horizon><option value="">All horizons</option>{horizons.map(h=><option value={h.id}>{h.label}</option>)}</select></label><button type="button" data-timeline-reset>Reset</button></div>
<div class="timeline-board"><div class="timeline-board-top"><span>Sector × estimated horizon</span><span>Choose a cell to explore ↓</span></div><div class="timeline-scroll" tabindex="0" role="region" aria-label="Technology horizon map. Scroll horizontally on smaller screens."><div class="timeline-matrix"><div class="matrix-corner">Technology sector</div>{horizons.map(h=><div class="matrix-head">{h.short}</div>)}{sectors.map(s=>{const v=visualFor(s.id);return <><a href={url(`/sectors/${s.id}/`)} class="matrix-label" style={`--sector:${v.color}`}><span aria-hidden="true">{v.icon}</span>{v.short}</a>{horizons.map(h=>{const count=technologies.filter(t=>t.sector===s.id&&horizonFor(t.estimateYear)===h.id).length;return <button type="button" data-map-sector={s.id} data-map-horizon={h.id} disabled={!count} aria-pressed="false" aria-label={`${s.title}, ${h.label}: ${count} records`} style={`--cell:${v.color};--intensity:${.07+Math.sqrt(count/max)*.4}`}><span>{count||'—'}</span></button>;})}</>})}</div></div><div class="timeline-board-note"><span>Counts come from the imported research catalogue.</span><span>Colour depth = number of records, not confidence.</span></div></div>
<div class="timeline-results-top"><h2>Explore the records.</h2><span data-timeline-status role="status" aria-live="polite">{technologies.length} records</span></div><div class="timeline-results">{technologies.map(t=>{const v=visualFor(t.sector);return <article data-timeline-item data-sector={t.sector} data-horizon={horizonFor(t.estimateYear)} style={`--sector:${v.color};--sector-pale:${v.pale}`}><div class="timeline-item-meta"><a href={url(`/sectors/${t.sector}/`)}>{v.short}</a><span>{t.estimateYear??'No recorded year'}</span></div><h3><a href={url(`/tech/${t.id}/`)}>{t.title}</a></h3>{t.summary&&<p>{t.summary}</p>}<a class="timeline-read" href={url(`/tech/${t.id}/`)}>Read the research →</a></article>;})}</div><p class="empty-state" data-timeline-empty hidden>No records in this combination. Try another horizon or sector.</p><nav class="pagination" data-timeline-pages hidden aria-label="Timeline result pages"><button type="button" data-timeline-previous>← Previous</button><span data-timeline-page></span><button type="button" data-timeline-next>Next →</button></nav>
</section>
<script>
const seen=new WeakSet();
function init(){const root=document.querySelector<HTMLElement>('[data-timeline]');if(!root||seen.has(root))return;seen.add(root);const sector=root.querySelector<HTMLSelectElement>('[data-timeline-sector]')!,horizon=root.querySelector<HTMLSelectElement>('[data-timeline-horizon]')!,items=[...root.querySelectorAll<HTMLElement>('[data-timeline-item]')];const params=new URLSearchParams(location.search);sector.value=params.get('sector')||'';horizon.value=params.get('horizon')||'';let page=Math.max(1,Number(params.get('page'))||1);const size=12,previous=root.querySelector<HTMLButtonElement>('[data-timeline-previous]')!,next=root.querySelector<HTMLButtonElement>('[data-timeline-next]')!;
function render(update=true){const matches=items.filter(item=>(!sector.value||item.dataset.sector===sector.value)&&(!horizon.value||item.dataset.horizon===horizon.value));const pages=Math.max(1,Math.ceil(matches.length/size));page=Math.min(page,pages);const visible=new Set(matches.slice((page-1)*size,page*size));items.forEach(item=>item.hidden=!visible.has(item));root!.querySelector('[data-timeline-status]')!.textContent=`${matches.length} of ${items.length} records`;root!.querySelector<HTMLElement>('[data-timeline-empty]')!.hidden=matches.length>0;root!.querySelector<HTMLElement>('[data-timeline-pages]')!.hidden=pages<2;root!.querySelector('[data-timeline-page]')!.textContent=`${page} / ${pages}`;previous.disabled=page===1;next.disabled=page===pages;root!.querySelectorAll<HTMLButtonElement>('[data-map-sector]').forEach(button=>button.setAttribute('aria-pressed',String(sector.value===button.dataset.mapSector&&horizon.value===button.dataset.mapHorizon)));if(update){const url=new URL(location.href);for(const key of ['sector','horizon','page'])url.searchParams.delete(key);if(sector.value)url.searchParams.set('sector',sector.value);if(horizon.value)url.searchParams.set('horizon',horizon.value);if(page>1)url.searchParams.set('page',String(page));history.replaceState(null,'',url);}}
for(const field of [sector,horizon])field.addEventListener('change',()=>{page=1;render();});root.querySelectorAll<HTMLButtonElement>('[data-map-sector]').forEach(button=>button.addEventListener('click',()=>{sector.value=button.dataset.mapSector!;horizon.value=button.dataset.mapHorizon!;page=1;render();}));root.querySelector('[data-timeline-reset]')!.addEventListener('click',()=>{sector.value='';horizon.value='';page=1;render();});for(const [button,delta] of [[previous,-1],[next,1]] as const)button.addEventListener('click',()=>{page+=delta;render();root.querySelector('.timeline-results-top')!.scrollIntoView({block:'start'});});root.querySelector<HTMLElement>('.timeline-controls')!.hidden=false;render(false);}
document.addEventListener('astro:page-load',init);init();
</script>
